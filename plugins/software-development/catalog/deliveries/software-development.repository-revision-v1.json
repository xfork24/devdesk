{
  "type": "delivery_type",
  "identity": "software-development.repository-revision",
  "revision": 1,
  "scope": "global",
  "name": "Repository Revision",
  "data": {
    "format": "json",
    "content_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    }
  },
  "spec_refs": [
    "software-development.preflight-contract:1"
  ]
}
