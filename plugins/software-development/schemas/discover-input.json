{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "revision"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}
