{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "source",
    "files",
    "notes",
    "configuration"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "source": {
      "enum": [
        "repository",
        "unconfigured"
      ]
    },
    "files": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "configuration": {
      "$ref": "#/$defs/ProjectTestConfiguration"
    }
  },
  "$defs": {
    "ProjectTestConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "independent_runner",
        "regression"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "independent_runner": {
          "enum": [
            "node_test",
            "python_unittest"
          ]
        },
        "regression": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectTestRecipe"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProjectTestRecipe": {
      "type": "object",
      "required": [
        "runner",
        "files",
        "timeout_seconds"
      ],
      "properties": {
        "runner": {
          "enum": [
            "node_test",
            "python_unittest",
            "command"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/]+(?:/[^/]+)*$",
            "not": {
              "pattern": "(^[-/]|[\\\\\\r\\n\\u0000]|(?:^|/)\\.{1,2}(?:/|$))"
            }
          }
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestCommand"
            },
            {
              "type": "null"
            }
          ]
        },
        "preparation": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/TestCommand"
          }
        }
      },
      "additionalProperties": false,
      "description": "Project test entry. Image is resolved from the frozen Sandbox at execution."
    },
    "TestCommand": {
      "type": "object",
      "required": [
        "argv"
      ],
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "cwd": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    }
  }
}
