{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "owner"
  ],
  "properties": {
    "kind": {
      "enum": [
        "feature",
        "task",
        "candidate"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    }
  }
}
