{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "mainline"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "mainline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
