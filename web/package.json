{
  "name": "devdesk-web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:core && npm run build:software",
    "build:core": "tsc --noEmit -p tsconfig.core.json && vite build --config vite.core.config.ts",
    "test:e2e": "cd .. && playwright test --config tests/browser/playwright.config.ts",
    "lint": "cd .. && eslint --config web/eslint.config.js web tests/browser tests/fixtures/workbench --max-warnings 0",
    "lint:fix": "cd .. && eslint --config web/eslint.config.js web tests/browser tests/fixtures/workbench --fix",
    "format": "prettier --write . ../tests/browser ../tests/fixtures/workbench",
    "format:check": "prettier --check . ../tests/browser ../tests/fixtures/workbench",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../tests/browser/tsconfig.json",
    "build:software": "vite build --config vite.software.config.ts",
    "build:fixture": "vite build --config ../tests/fixtures/workbench/vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0"
  }
}
