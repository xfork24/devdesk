{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDesk immutable file manifest v1",
  "description": "Immutable delivery manifests, engineering snapshot envelopes, and bare project/conversation Snapshot files emitted by the current engine. Referenced schemas ship alongside this file.",
  "oneOf": [
    {
      "$ref": "#/$defs/DeliveryManifest"
    },
    {
      "$ref": "#/$defs/SnapshotManifest"
    },
    {
      "$ref": "#/$defs/Snapshot"
    }
  ],
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relative_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string"
        },
        "origin": {
          "$ref": "rpc.schema.json#/$defs/Origin"
        }
      },
      "required": [
        "id",
        "relative_path",
        "sha256",
        "media_type",
        "origin"
      ]
    },
    "TaskScope": {
      "type": "object",
      "properties": {
        "requirement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "design": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "acceptance"
      ]
    },
    "Attempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "feature_id": {
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "type": "string"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "live_sessions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "git_context": {
          "anyOf": [
            {
              "$ref": "rpc.schema.json#/$defs/GitContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "rpc.schema.json#/$defs/Status"
        },
        "input_version": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "$ref": "rpc.schema.json#/$defs/BindingLock"
        },
        "context_content": {
          "type": "string"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 0
        },
        "paused": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "feature_id",
        "phase",
        "status",
        "input_version",
        "documents",
        "outputs",
        "binding",
        "context_content",
        "context_revision",
        "paused",
        "revision"
      ]
    },
    "SnapshotCapture": {
      "type": "object",
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "captured_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "runs",
        "sessions",
        "resources",
        "reason"
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "binding": {
          "$ref": "rpc.schema.json#/$defs/BindingLock"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inherited_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture": {
          "$ref": "#/$defs/SnapshotCapture"
        },
        "runtime_bindings": {
          "type": "array",
          "items": {
            "$ref": "rpc.schema.json#/$defs/RuntimeBinding"
          }
        },
        "execution_instances": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "content",
        "binding",
        "documents",
        "capture"
      ]
    },
    "ChangeRequestRef": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "external_id": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        },
        "target_revision": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "repository",
        "external_id",
        "source_revision",
        "target_revision"
      ]
    },
    "Merge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "feature_id": {
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "rpc.schema.json#/$defs/Status"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "input_version": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string"
        },
        "source_delivery": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "expected_target": {
          "type": "string"
        },
        "candidate": {
          "type": "string"
        },
        "committed_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeRequestRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "feature_id",
        "status",
        "revision",
        "input_version",
        "source",
        "source_delivery",
        "target",
        "expected_target",
        "candidate"
      ]
    },
    "PullRequestReceipt": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "head_branch": {
          "type": "string"
        },
        "base_branch": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "merged": {
          "type": "boolean"
        },
        "merge_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "marker": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "number",
        "url",
        "head_branch",
        "base_branch",
        "head",
        "base",
        "merged",
        "marker"
      ]
    },
    "RepositoryOperation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "publish_ref"
                },
                "merge": {
                  "type": "string"
                },
                "context": {
                  "$ref": "rpc.schema.json#/$defs/GitContext"
                },
                "branch": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "expected": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stage": {
                  "enum": [
                    "target_base",
                    "candidate",
                    "remote_advance"
                  ]
                }
              },
              "required": [
                "kind",
                "merge",
                "context",
                "branch",
                "revision",
                "stage"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "pull_request"
                },
                "merge": {
                  "type": "string"
                },
                "request": {
                  "$ref": "rpc.schema.json#/$defs/PullRequestRequest"
                },
                "observe_only": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "merge",
                "request",
                "observe_only"
              ],
              "additionalProperties": false
            }
          ]
        },
        "status": {
          "enum": [
            "prepared",
            "dispatched",
            "observed",
            "completed",
            "needs_reconciliation"
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "published_ref"
                    },
                    "revision": {
                      "type": "string"
                    },
                    "branch": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "revision",
                    "branch"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "pull_request"
                    },
                    "pull_request": {
                      "$ref": "#/$defs/PullRequestReceipt"
                    }
                  },
                  "required": [
                    "kind",
                    "pull_request"
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "project_id",
        "action",
        "status",
        "reason",
        "revision"
      ]
    },
    "DeliveryManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "delivery_id": {
          "type": "string"
        },
        "report_artifact": {
          "$ref": "#/$defs/Artifact"
        },
        "input_version": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_deliveries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "rpc.schema.json#/$defs/Origin"
        },
        "attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attempt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "delivery_id",
        "report_artifact",
        "input_version",
        "documents",
        "evidence",
        "source_deliveries",
        "candidate",
        "origin",
        "attempt"
      ],
      "additionalProperties": false
    },
    "SnapshotManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "execution_mode": {
          "enum": [
            "live"
          ],
          "description": "Only native live execution is accepted."
        },
        "merge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Merge"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepositoryOperation"
          }
        }
      },
      "required": [
        "schema_version",
        "snapshot",
        "execution_mode",
        "merge",
        "repository_receipts"
      ],
      "additionalProperties": false
    }
  }
}
