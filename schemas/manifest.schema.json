{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDesk immutable conversation snapshot",
  "description": "Exact sources and runtime facts captured from a conversation.",
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relative_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string"
        },
        "origin": {
          "$ref": "rpc.schema.json#/$defs/Origin"
        }
      },
      "required": [
        "id",
        "relative_path",
        "sha256",
        "media_type",
        "origin"
      ]
    },
    "SnapshotCapture": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "captured_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "step_execution_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sessions",
        "reason"
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inherited_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture": {
          "$ref": "#/$defs/SnapshotCapture"
        },
        "runtime_bindings": {
          "type": "array",
          "items": {
            "$ref": "rpc.schema.json#/$defs/RuntimeBinding"
          }
        },
        "execution_instances": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "content",
        "documents",
        "capture"
      ]
    }
  },
  "$ref": "#/$defs/Snapshot"
}
