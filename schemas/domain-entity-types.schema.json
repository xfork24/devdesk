{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDesk domain entity declarations",
  "type": "object",
  "maxProperties": 32,
  "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,139}:[1-9][0-9]{0,9}$" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "schema"],
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 140 },
      "schema": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object" } } },
      "relations": {
        "type": "object",
        "maxProperties": 16,
        "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,139}$" },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "max_items"],
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "min_items": { "type": "integer", "minimum": 0, "maximum": 16 },
            "max_items": { "type": "integer", "minimum": 1, "maximum": 16 }
          }
        }
      },
      "workflows": {
        "type": "object",
        "maxProperties": 32,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "outputs"],
          "properties": {
            "input": { "type": "string", "minLength": 1 },
            "owner_relations": {
              "type": "object",
              "maxProperties": 16,
              "additionalProperties": {
                "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 140 }
              }
            },
            "outputs": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
