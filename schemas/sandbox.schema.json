{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDesk Sandbox definition",
  "type": "object",
  "properties": {
    "provider": {
      "const": "docker"
    },
    "runtime_version": {
      "const": "1"
    },
    "enforcement": {
      "const": "docker-worker/v1"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux/aarch64",
          "linux/x86_64"
        ]
      }
    }
  },
  "required": [
    "provider",
    "runtime_version",
    "enforcement",
    "platforms"
  ],
  "additionalProperties": false
}
