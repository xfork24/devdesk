{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devdesk.invalid/schemas/stage-answer.schema.json",
  "title": "Formal stage evidence checks",
  "description": "A delivery validation or independent review report. It does not create a proposal or accept a delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["approve", "summary", "checks"],
  "properties": {
    "approve": {"type": "boolean"},
    "summary": {"type": "string", "pattern": "\\S"},
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "passed", "evidence"],
        "properties": {
          "key": {"enum": ["traceability", "scope", "tests", "failure_paths"]},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string", "pattern": "\\S"}
        }
      },
      "allOf": [
        {"contains": {"properties": {"key": {"const": "traceability"}}, "required": ["key"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"key": {"const": "scope"}}, "required": ["key"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"key": {"const": "tests"}}, "required": ["key"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"key": {"const": "failure_paths"}}, "required": ["key"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  }
}
