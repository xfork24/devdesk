{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDesk finite Workflow action contracts v1 and v2",
  "type": "object",
  "required": [
    "kind",
    "contract_version"
  ],
  "properties": {
    "kind": {
      "enum": [
        "agent.interact",
        "proposal.adopt",
        "attempt.execute",
        "delivery.review",
        "merge.prepare",
        "merge.review",
        "merge.apply",
        "snapshot.capture",
        "resource.cleanup",
        "tasks.foreach",
        "branch",
        "join",
        "workflow.call"
      ]
    },
    "contract_version": {
      "enum": [
        1,
        2
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "agent.interact",
              "attempt.execute",
              "delivery.review",
              "merge.review"
            ]
          }
        }
      }
    }
  ]
}
