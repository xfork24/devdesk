{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devdesk.local/schemas/permission.schema.json",
  "$defs": {
    "PermissionPolicy": {
      "type": "object",
      "properties": {
        "filesystem": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "full_access"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "read_only"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "scoped"
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^/"
                      },
                      "access": {
                        "enum": [
                          "deny",
                          "read",
                          "read_write"
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "access"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "mode",
                "rules"
              ],
              "additionalProperties": false
            }
          ]
        },
        "network": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "enabled"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "disabled"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "allowlist"
                },
                "destinations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "mode",
                "destinations"
              ],
              "additionalProperties": false
            }
          ]
        },
        "tools": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "all_available"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "restricted"
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "mode",
                "allow",
                "deny"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "filesystem",
        "network",
        "tools"
      ],
      "additionalProperties": false
    },
    "PermissionRef": {
      "type": "object",
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "revision_id"
      ],
      "additionalProperties": false
    }
  },
  "title": "DevDesk portable permission types",
  "$ref": "https://devdesk.invalid/schemas/permission-profile.schema.json"
}
