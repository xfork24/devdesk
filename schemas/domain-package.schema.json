{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDesk domain ZIP manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "version", "files"],
  "properties": {
    "format": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/identifier" },
    "entity_types": { "$ref": "#/$defs/path", "pattern": "^configurations/entity-types/.+[.]json$" },
    "files": {
      "type": "object",
      "maxProperties": 255,
      "propertyNames": { "$ref": "#/$defs/path" },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "extensions": { "$ref": "#/$defs/extensions" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "handlers"],
      "properties": {
        "entry": { "$ref": "#/$defs/path", "pattern": "^runtime/.+[.]mjs$" },
        "project_connection": { "$ref": "#/$defs/identifier" },
        "handlers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "core": { "enum": ["git_head", "git_snapshot"] },
              "git_snapshot": {
                "type": "object",
                "additionalProperties": false,
                "required": ["files"],
                "properties": {
                  "files": { "type": "array", "items": { "type": "string" }, "maxItems": 16, "uniqueItems": true },
                  "searches": {
                    "type": "object",
                    "maxProperties": 8,
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["glob", "needles"],
                      "properties": {
                        "glob": { "type": "string" },
                        "needles": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
                      }
                    }
                  }
                }
              },
              "input_schema": { "type": ["object", "boolean"] },
              "output_schema": { "type": ["object", "boolean"] }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributions", "targets"],
      "properties": {
        "contributions": { "$ref": "#/$defs/path" },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["renderer", "api", "bindings"],
            "properties": {
              "renderer": { "$ref": "#/$defs/identifier" },
              "api": { "type": "integer", "minimum": 1 },
              "styles": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/path", "pattern": "^ui/web/.*\\.css$" }
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["contribution", "entry", "export"],
                  "properties": {
                    "contribution": { "$ref": "#/$defs/identifier" },
                    "entry": { "$ref": "#/$defs/path", "pattern": "^ui/" },
                    "export": { "$ref": "#/$defs/identifier" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,139}$" },
    "group": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,139}/[1-9][0-9]{0,9}$" },
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "$ref": "#/$defs/group" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handlers": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": { "$ref": "#/$defs/identifier" },
            "additionalProperties": { "$ref": "#/$defs/identifier" }
          },
          "resources": {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": { "$ref": "#/$defs/identifier" },
            "additionalProperties": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": { "$ref": "#/$defs/path", "pattern": "^runtime/.+" }
            }
          }
        }
      }
    },
    "path": { "type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,139}(/[A-Za-z0-9][A-Za-z0-9._-]{0,139})*$" }
  }
}
