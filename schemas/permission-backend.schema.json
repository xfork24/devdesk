{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDesk permission backend manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "assets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "docker",
              "codex",
              "dsh"
            ]
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nested_sandbox": {
            "type": "boolean"
          },
          "apparmor_profile": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "docker"
                }
              }
            },
            "then": {
              "required": [
                "platforms",
                "nested_sandbox"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "enum": [
                    "codex",
                    "dsh"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "version"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "nested_sandbox": {
                  "const": true
                }
              },
              "required": [
                "nested_sandbox"
              ]
            },
            "then": {
              "required": [
                "apparmor_profile"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "upstream": {
      "type": "object",
      "properties": {
        "moby_seccomp_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "apparmor_source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "moby_seccomp_commit",
        "apparmor_source"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "backends",
    "upstream",
    "assets"
  ],
  "additionalProperties": false
}
