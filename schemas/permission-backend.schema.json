{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevDesk permission backend manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "assets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "upstream": {
      "type": "object"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "backends",
    "upstream",
    "assets"
  ],
  "additionalProperties": false
}
