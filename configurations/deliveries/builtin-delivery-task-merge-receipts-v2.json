{
  "type": "delivery_type",
  "identity": "builtin-delivery-task-merge-receipts",
  "revision": 2,
  "name": "Task Merge Receipts",
  "scope": "global",
  "spec_refs": [
    "builtin-spec-platform-evidence:2"
  ],
  "data": {
    "format": "json",
    "producer": {
      "kind": "workflow"
    },
    "content_schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "publication",
          "pull_request",
          "revision",
          "sync",
          "synchronized"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "publication": {
            "type": "object"
          },
          "pull_request": {
            "type": "object",
            "required": [
              "merged",
              "merge_commit"
            ],
            "properties": {
              "merged": {
                "const": true
              },
              "merge_commit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "synchronized": {
            "const": true
          },
          "sync": {
            "type": "object",
            "required": [
              "revision",
              "synchronized"
            ],
            "properties": {
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "synchronized": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
