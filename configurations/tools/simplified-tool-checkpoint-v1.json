{
  "type": "tool",
  "identity": "simplified-tool-checkpoint",
  "revision": 1,
  "name": "精简版自动代码检查点",
  "scope": "global",
  "data": {
    "qualified_name": "workspace.checkpoint",
    "implementation": "platform",
    "input_schema": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_diff": {
          "type": "boolean"
        },
        "diff_base": {
          "type": "object"
        },
        "interfaces": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "runner",
              "exports"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "runner": {
                "enum": [
                  "node_test",
                  "python_unittest"
                ]
              },
              "exports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace",
        "allowed_paths"
      ]
    },
    "output_schema": {
      "type": "object"
    },
    "capabilities": []
  }
}
