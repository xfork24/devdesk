{
  "extends": "../../web/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "typeRoots": ["../../web/node_modules/@types", "../../web/node_modules"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      // Keep TypeScript declarations and the Playwright loader’s ESM entry.
      "@playwright/test": [
        "../../web/node_modules/@playwright/test",
        "../../web/node_modules/@playwright/test/index.mjs"
      ],
      "react": ["../../web/node_modules/@types/react"],
      "react/*": ["../../web/node_modules/@types/react/*"],
      "react-dom/*": ["../../web/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../fixtures/workbench"]
}
