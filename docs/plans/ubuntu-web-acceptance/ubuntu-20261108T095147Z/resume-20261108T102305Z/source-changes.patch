+            Ok(value) => {
+                self.pending = true;
+                self.login = Some(value.clone());
+                Ok(value)
+            }
+            Err(error) => {
+                self.pending = false;
+                self.login = None;
+                // The native request may have been consumed before timing out.
+                // Stop this authentication process before a later explicit retry.
+                self.restart_required = true;
+                Err(error)
+            }
+        }
+    }
