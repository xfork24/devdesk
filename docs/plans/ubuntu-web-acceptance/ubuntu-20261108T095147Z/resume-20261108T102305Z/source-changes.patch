+  signal (receive) peer=runc,
+  signal (receive) peer=crun,
+  signal (send,receive) peer=devdesk-harness-v1,
+  ptrace (trace,tracedby,read,readby) peer=devdesk-harness-v1,
+
+  # Bubblewrap: make the inherited root a slave, create its temporary root
+  # over /tmp, then construct /newroot from already-visible container paths.
+  # Unlisted filesystems/flags/destinations remain denied (no blanket mount).
+  mount options in (rw,rslave,silent) -> /,
+  mount fstype=tmpfs options in (rw,nosuid,nodev,noexec,relatime,strictatime,silent) -> /tmp/,
+  mount options in (rw,bind,rbind,silent) -> /tmp/newroot/,
+  pivot_root oldroot=/tmp/oldroot/ /tmp/,
+  mount options in (rw,ro,bind,rbind,remount,nosuid,nodev,noexec,relatime,strictatime,silent) -> /newroot{,/**},
+  mount fstype in (tmpfs,proc,devpts) options in (rw,ro,nosuid,nodev,noexec,relatime,strictatime,silent) -> /newroot{,/**},
+  mount options in (rw,rprivate,silent) -> /oldroot/,
+  umount /oldroot/,
+  pivot_root oldroot=/newroot/ /newroot/,
+  umount /,
+
+  # Preserve Moby's proc/sys restrictions, including the setup-time aliases.
+  deny /{,oldroot/,newroot/}proc/* w,
+  deny /{,oldroot/,newroot/}proc/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
+  deny /{,oldroot/,newroot/}proc/sys/[^k]** w,
+  deny /{,oldroot/,newroot/}proc/sys/kernel/{?,??,[^s][^h][^m]**} w,
+  deny /{,oldroot/,newroot/}proc/sysrq-trigger rwklx,
+  deny /{,oldroot/,newroot/}proc/kcore rwklx,
+  deny /{,oldroot/,newroot/}sys/[^f]*/** wklx,
+  deny /{,oldroot/,newroot/}sys/f[^s]*/** wklx,
+  deny /{,oldroot/,newroot/}sys/fs/[^c]*/** wklx,
+  deny /{,oldroot/,newroot/}sys/fs/c[^g]*/** wklx,
+  deny /{,oldroot/,newroot/}sys/fs/cg[^r]*/** wklx,
+  deny /{,oldroot/,newroot/}sys/firmware/** rwklx,
+  deny /{,oldroot/,newroot/}sys/devices/virtual/powercap/** rwklx,
+  deny /{,oldroot/,newroot/}sys/kernel/security/** rwklx,
+}
diff --git a/scripts/install-linux-sandbox-policy.sh b/scripts/install-linux-sandbox-policy.sh
new file mode 100755
index 0000000..154e415
--- /dev/null
+++ b/scripts/install-linux-sandbox-policy.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# Install only DevDesk's named worker profile; never change docker-default,
+# daemon settings, sysctls, capabilities or AppArmor's enforcement mode.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+policy=containers/security/devdesk-harness-v1.apparmor
+destination=/etc/apparmor.d/devdesk-harness-v1
+if [[ "$(uname -s)" != Linux ]]; then
+  echo "This profile is for an AppArmor-enabled Linux Docker host." >&2
+  exit 1
+fi
+apparmor_parser --skip-kernel-load --skip-cache "$policy"
+if [[ "${1:---check}" == --check ]]; then
+  sha256sum "$policy"
+  exit 0
+fi
+if [[ "${1:-}" != --install || $# != 1 ]]; then
+  echo "Usage: $0 --check | --install" >&2
+  exit 2
+fi
+if [[ "$(id -u)" != 0 ]]; then
+  echo "Loading a named kernel profile requires root. Run: sudo $0 --install" >&2
+  exit 1
+fi
+if [[ -L "$destination" ]]; then
+  echo "Refusing a symlink at $destination" >&2
+  exit 1
+fi
+if [[ -e "$destination" ]] && ! cmp -s "$policy" "$destination"; then
+  echo "Existing profile differs; review/version it explicitly before replacing it." >&2
+  exit 1
+fi
+install -m 0644 -o root -g root "$policy" "$destination"
+apparmor_parser --replace --skip-cache "$destination"
+sha256sum "$destination"
+echo "Loaded devdesk-harness-v1. docker-default and existing containers are unchanged."
diff --git a/tests/live/probe_linux_credentials.mjs b/tests/live/probe_linux_credentials.mjs
new file mode 100644
index 0000000..f81c708
--- /dev/null
+++ b/tests/live/probe_linux_credentials.mjs
@@ -0,0 +1,158 @@
+// Actual Linux Secret Service, isolated synthetic entries, browser settings and Host restart.
+// No model credentials are used. Secret values never enter argv or the report.
+import { chromium } from '../../web/node_modules/playwright/index.mjs';
+import { spawn, spawnSync } from 'node:child_process';
+import { createHash, randomBytes } from 'node:crypto';
+import { once } from 'node:events';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import readline from 'node:readline';
+
+const args = process.argv.slice(2);
+const option = (name, fallback) => {
+  const index = args.indexOf(name);
+  return index < 0 ? fallback : args[index + 1];
+};
+const output = option('--output');
+if (!output || process.platform !== 'linux') throw new Error('Linux and --output are required');
+const binary = path.resolve(option('--binary', 'target/debug/devdesk-host'));
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'devdesk-linux-credentials-'));
+const dataset = path.join(root, 'data');
+const service = 'devdesk.' + createHash('sha256').update(dataset).digest('hex');
+const secrets = [randomBytes(24).toString('hex'), randomBytes(24).toString('hex')];
+const references = [];
+const report = {
+  passed: false, source: 'actual Chromium → Host → Linux Secret Service',
+  synthetic_entries_only: true, collection_lock_tested: false,
+  unavailable_backend_test: 'dedicated Host with unreachable session D-Bus',
+  binary, dataset, hosts: [], checks: [],
+};
+const check = (value, name) => {
+  if (!value) throw new Error(name);
+  report.checks.push(name);
+};
+let host, browser, page, url;
+const start = async (unavailable = false) => {
+  const argv = ['--data', dataset, '--port', '0'];
+  host = spawn(binary, argv, {
+    cwd: root, env: { ...process.env, ...(unavailable ? {
+      DBUS_SESSION_BUS_ADDRESS: 'unix:path=' + path.join(root, 'absent-session-bus'),
+    } : {}) }, stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  host.stderr.resume();
+  report.hosts.push({ pid: host.pid, argv: [binary, ...argv], unavailable_backend: unavailable });
+  const lines = readline.createInterface({ input: host.stdout });
+  const ready = (async () => {
+    for await (const line of lines) if (line.startsWith('http://127.0.0.1:')) return line;
+    throw new Error('host_start_failed');
+  })();
+  let timeout;
+  try {
+    url = await Promise.race([ready, new Promise((_, reject) => {
+      timeout = setTimeout(() => reject(new Error('host_start_timeout')), 15000);
+    })]);
+  } finally { clearTimeout(timeout); lines.close(); host.stdout.resume(); }
+  page = await browser.newPage();
+  await page.goto(url);
+};
+const rpc = async (method, params = {}, allowError = false) => {
+  const response = await page.request.post(url + '/rpc', {
+    data: { jsonrpc: '2.0', id: 1, method, params },
+  });
+  const body = await response.json();
+  check(!secrets.some(secret => JSON.stringify(body).includes(secret)), 'rpc_response_contains_no_secret');
+  if (body.error && !allowError) throw new Error(method + ':' + body.error.data.code);
+  return allowError ? body : body.result;
+};
+const stop = async () => {
+  if (!host || host.exitCode !== null) return;
+  const exited = once(host, 'exit');
+  await page.request.post(url + '/shutdown', { data: {} });
+  const [code] = await exited;
+  check(code === 0, 'owned_host_gracefully_stopped');
+  await page.close();
+};
+const tool = (operation, account) => spawnSync('secret-tool', [operation, 'service', service, 'account', account], { timeout: 20000 });
+const account = reference => {
+  check(reference.startsWith(service + ':'), 'entry_belongs_to_probe_dataset');
+  return reference.slice(service.length + 1);
+};
+
+try {
+  browser = await chromium.launch({ headless: true });
+  await start();
+  check(!(await rpc('credentials.status')).configured, 'missing_key_status');
+  check(Boolean((await rpc('credentials.check', {}, true)).error), 'missing_key_read_rejected');
+  const project = await rpc('project.create', {
+    command_id: randomBytes(16).toString('hex'), payload: { title: 'Linux credential probe' },
+  });
+  report.project_id = project.id;
+  await page.getByRole('button', { name: '设置', exact: true }).click();
+  for (const secret of secrets) {
+    const password = page.getByLabel('配置或更换 API key');
+    await password.fill(secret);
+    const saved = page.waitForResponse(response => response.url() === url + '/rpc'
+      && response.request().postDataJSON()?.method === 'credentials.configure');
+    await page.getByRole('button', { name: '保存密钥', exact: true }).click();
+    const body = await (await saved).json();
+    check(!body.error, 'browser_key_saved');
+    references.push(body.result.reference);
+    await page.waitForFunction(() => document.querySelector('#deepseek-api-key')?.value === '');
+    check((await password.inputValue()) === '', 'password_field_cleared');
+    await rpc('credentials.check');
+    const actual = tool('lookup', account(body.result.reference));
+    check(actual.status === 0 && actual.stdout.toString().trimEnd() === secret, 'actual_secret_service_value_matches');
+  }
+  check(references[0] !== references[1], 'updates_create_new_opaque_reference');
+  check(tool('lookup', account(references[0])).stdout.toString().trimEnd() === secrets[0], 'old_frozen_reference_preserved');
+  const storage = await page.evaluate(() => JSON.stringify([Object.entries(localStorage), Object.entries(sessionStorage)]));
+  check(!secrets.some(secret => storage.includes(secret)), 'browser_storage_contains_no_secret');
+  for (const name of fs.readdirSync(dataset).filter(name => name.startsWith('global.sqlite3'))) {
+    const bytes = fs.readFileSync(path.join(dataset, name));
+    check(!secrets.some(secret => bytes.includes(secret)), 'sqlite_contains_no_secret');
+  }
+  await stop();
+  await start();
+  check((await rpc('credentials.status')).reference === references[1], 'reference_survives_restart');
+  check((await rpc('query.workspace')).projects.some(value => value.id === project.id), 'existing_project_survives_restart');
+  await rpc('credentials.check');
+  report.checks.push('secret_read_survives_restart');
+  await stop();
+  await start(true);
+  const started = Date.now();
+  check((await rpc('credentials.status')).configured, 'unavailable_backend_status_uses_metadata');
+  check(Date.now() - started < 2000, 'unavailable_backend_status_is_responsive');
+  const failed = await rpc('credentials.check', {}, true);
+  check(failed.error?.data?.code === 'authentication_required', 'unavailable_backend_explicit_error');
+  check(Date.now() - started < 20000, 'unavailable_backend_read_is_bounded');
+  check(!fs.existsSync(path.join(dataset, 'runtime.json')), 'no_plaintext_fallback');
+  await stop();
+  await start();
+  await rpc('credentials.check');
+  for (const reference of references) check(tool('clear', account(reference)).status === 0, 'probe_entry_deleted');
+  check(Boolean((await rpc('credentials.check', {}, true)).error), 'deleted_key_read_rejected');
+  for (const reference of references) check(tool('lookup', account(reference)).status !== 0, 'deleted_entry_absent');
+  await stop();
+  report.passed = true;
+} catch (error) {
+  report.error = secrets.some(secret => String(error).includes(secret)) ? 'redacted_probe_failure' : String(error);
+} finally {
+  if (host?.exitCode === null) {
+    try { await stop(); } catch { host.kill('SIGTERM'); await once(host, 'exit'); }
+  }
+  await browser?.close();
+  report.cleanup = references.map(reference => ({
+    reference, clear_exit: tool('clear', account(reference)).status,
+    absent: tool('lookup', account(reference)).status === 1,
+  }));
+  report.executors_released = report.hosts.every(({ pid }) => {
+    try { process.kill(pid, 0); return false; } catch { return true; }
+  });
+  report.passed &&= report.executors_released && report.cleanup.every(entry => entry.absent);
+  fs.mkdirSync(path.dirname(path.resolve(output)), { recursive: true });
+  fs.writeFileSync(output, JSON.stringify(report, null, 2) + '\n');
+  fs.rmSync(root, { recursive: true, force: true });
+}
+console.log(JSON.stringify({ passed: report.passed, output }));
+process.exitCode = report.passed ? 0 : 1;
diff --git a/tests/live/probe_oauth_recovery.mjs b/tests/live/probe_oauth_recovery.mjs
new file mode 100644
index 0000000..ce1da14
--- /dev/null
+++ b/tests/live/probe_oauth_recovery.mjs
@@ -0,0 +1,112 @@
+// Real native OAuth start/cancel with an intentionally lost local HTTP response.
+// Official authorization navigation is intercepted; no user login or token is used.
+import { chromium, expect } from '../../web/node_modules/@playwright/test/index.mjs';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import readline from 'node:readline';
+
+const args = process.argv.slice(2);
+const option = (key, fallback) => args.includes(key) ? args[args.indexOf(key) + 1] : fallback;
+const output = option('--output');
+if (!output) throw new Error('--output is required');
+const binary = path.resolve(option('--binary', 'target/debug/devdesk-host'));
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'devdesk-oauth-recovery-'));
+const dataset = path.join(root, 'data');
+const argv = [binary, '--data', dataset, '--port', '0'];
+const host = spawn(binary, argv.slice(1), { cwd: root, stdio: ['ignore', 'pipe', 'ignore'] });
+const report = {
+  passed: false, source: 'actual browser → Host → native Codex OAuth',
+  official_login_completed: false, official_navigation_intercepted: true,
+  injected_fault: 'abort first local HTTP response after native start succeeded',
+  host: { pid: host.pid, argv }, checks: [],
+};
+let browser, page, url;
+const check = (condition, name) => {
+  if (!condition) throw new Error(name);
+  report.checks.push(name);
+};
+const rpc = async (method, params = {}) => {
+  const response = await page.request.post(url + '/rpc', { data: { jsonrpc: '2.0', id: 1, method, params } });
+  const body = await response.json();
+  if (body.error) throw new Error(method + ':' + body.error.data.code);
+  return body.result;
+};
+try {
+  const lines = readline.createInterface({ input: host.stdout });
+  const ready = (async () => {
+    for await (const line of lines) if (line.startsWith('http://127.0.0.1:')) return line;
+    throw new Error('host_start_failed');
+  })();
+  let timer;
+  try { url = await Promise.race([ready, new Promise((_, reject) => {
+    timer = setTimeout(() => reject(new Error('host_start_timeout')), 15000);
+  })]); } finally { clearTimeout(timer); lines.close(); host.stdout.resume(); }
+  browser = await chromium.launch({ headless: true });
+  const context = await browser.newContext();
+  await context.route('https://auth.openai.com/**', route => route.fulfill({ body: 'Authorization navigation fixture; no login performed.' }));
+  page = await context.newPage();
+  await page.goto(url);
+  const installation = await rpc('runtime.discover_codex');
+  report.installation_id = installation.id;
+  const params = { installation_id: installation.id };
+  await page.reload();
+  await page.getByRole('button', { name: '设置', exact: true }).click();
+  let dropped;
+  await page.route('**/rpc', async route => {
+    if (route.request().postDataJSON()?.method === 'codex.auth.start' && !dropped) {
+      const response = await route.fetch();
+      const body = await response.json();
+      if (body.error) throw new Error('initial_native_start_failed:' + body.error.data.code);
+      dropped = body.result;
+      await route.abort('failed');
+    } else await route.continue();
+  });
+  const loginButton = page.getByRole('button', { name: '网页登录', exact: true });
+  await loginButton.click();
+  await expect(page.getByText(/无法开始登录，可再次点击重试/)).toBeVisible();
+  check((await rpc('codex.auth.status', params)).pending, 'lost_response_leaves_actual_native_login_pending');
+  const recoveredResponse = page.waitForResponse(response => response.url() === url + '/rpc'
+    && response.request().postDataJSON()?.method === 'codex.auth.start');
+  await loginButton.click();
+  const recovered = (await (await recoveredResponse).json()).result;
+  check(recovered.loginId === dropped.loginId && recovered.authUrl === dropped.authUrl, 'explicit_retry_recovers_same_login');
+  check(new URL(recovered.authUrl).origin === 'https://auth.openai.com', 'actual_official_origin');
+  await expect(page.getByRole('link', { name: '打开官方授权网页', exact: true })).toBeVisible();
+  await page.unrouteAll({ behavior: 'wait' });
+  await page.reload();
+  await page.getByRole('button', { name: '设置', exact: true }).click();
+  await page.evaluate(() => { window.open = () => null; });
+  await loginButton.click();
+  await expect(page.getByText(/浏览器未打开新窗口/)).toBeVisible();
+  check(await page.getByRole('link', { name: '打开官方授权网页', exact: true }).getAttribute('href') === dropped.authUrl, 'reload_and_blocked_popup_keep_same_official_link');
+  await page.getByRole('button', { name: '取消登录', exact: true }).click();
+  await expect(page.getByRole('button', { name: '取消登录', exact: true })).toHaveCount(0);
+  check(!(await rpc('codex.auth.status', params)).pending, 'native_cancel_clears_pending');
+  const next = await rpc('codex.auth.start', params);
+  check(next.loginId !== dropped.loginId, 'new_explicit_login_after_cancel_has_new_identity');
+  await rpc('codex.auth.cancel', { ...params, login_id: next.loginId });
+  check(!(await rpc('codex.auth.status', params)).pending, 'second_native_login_cancelled');
+  report.passed = true;
+} catch (error) {
+  // Browser errors can include a full authorization URL. Keep only the class.
+  report.failure_type = error.constructor.name;
+} finally {
+  if (page && host.exitCode === null) {
+    const exited = once(host, 'exit');
+    await page.request.post(url + '/shutdown', { data: {} });
+    const [code] = await exited;
+    report.host_released = code === 0;
+  } else if (host.exitCode === null) {
+    host.kill('SIGTERM'); await once(host, 'exit'); report.host_released = true;
+  }
+  await browser?.close();
+  report.passed &&= report.host_released;
+  fs.mkdirSync(path.dirname(path.resolve(output)), { recursive: true });
+  fs.writeFileSync(output, JSON.stringify(report, null, 2) + '\n');
+  fs.rmSync(root, { recursive: true, force: true });
+}
+console.log(JSON.stringify({ passed: report.passed, output }));
+process.exitCode = report.passed ? 0 : 1;
