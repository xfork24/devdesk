{
  "type": "tool",
  "identity": "builtin-tool-workflow-cancel",
  "revision": 2,
  "name": "取消当前流程",
  "scope": "global",
  "data": {
    "qualified_name": "workflow.cancel",
    "implementation": "platform",
    "input_schema": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "plan_revision_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "control_version": {
          "type": "integer",
          "minimum": 1
        },
        "decision_ref": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "plan_revision_id",
        "expected_revision",
        "control_version"
      ],
      "additionalProperties": false,
      "description": "Stop pending work and await real stop evidence; already applied external effects remain facts. Preserve expected_revision from the original owner/instance read. For step writes preserve execution_id and expected_step_revision from that same read; do not refresh or retry conflicts with newer versions. Changes to control_version or plan_revision_id revoke the old request."
    },
    "output_schema": {
      "type": "object"
    },
    "capabilities": []
  }
}
