{
  "type": "tool",
  "identity": "builtin-tool-workflow-pause",
  "revision": 2,
  "name": "暂停流程派发",
  "scope": "global",
  "data": {
    "qualified_name": "workflow.pause",
    "implementation": "platform",
    "input_schema": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "plan_revision_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "control_version": {
          "type": "integer",
          "minimum": 1
        },
        "decision_ref": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "plan_revision_id",
        "expected_revision",
        "control_version"
      ],
      "additionalProperties": false,
      "description": "Pause workflow progress while receipts continue to be observed. The controller can still discuss plan changes. Preserve expected_revision from the original owner/instance read. For step writes preserve execution_id and expected_step_revision from that same read; do not refresh or retry conflicts with newer versions. Changes to control_version or plan_revision_id revoke the old request."
    },
    "output_schema": {
      "type": "object"
    },
    "capabilities": []
  }
}
