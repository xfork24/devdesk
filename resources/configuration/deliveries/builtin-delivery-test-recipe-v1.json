{
  "kind": "delivery_type",
  "identity": "builtin-delivery-test-recipe",
  "revision": 1,
  "name": "测试命令配方",
  "scope": {
    "kind": "global"
  },
  "data": {
    "body": "测试命令配方，按绑定的输入与输出声明提交。",
    "format": "json",
    "content_schema": {
      "type": "object",
      "required": [
