        "files",
        "timeout_seconds"
      ],
      "properties": {
        "runner": {
          "enum": [
            "node_test"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "spec_refs": []
  }
}
