{
  "kind": "delivery_type",
  "identity": "builtin-delivery-execution-evidence",
  "revision": 1,
  "name": "原始执行证据",
  "scope": {
    "kind": "global"
  },
  "data": {
    "format": "json",
    "body": "逐次真实执行的完整记录，作为命名输出持久化后由显式输入绑定传递。runs 按实际顺序记录阶段、完整命令、目录、起止时间、退出码、原始 stdout/stderr，以及该次执行对应的测试与实现文件内容和 SHA-256。不得仅提交 /tmp 路径、摘要或已通过声明；不得将 Agent 自行记录冒充平台测试回执。检查者应核对同一测试 Red→Green、真实业务断言和最终候选关联。 runs 的 minItems=2 只是一个增量的最低结构约束，不表示多增量任务只需两条记录。当前 Task/设计规定多个增量时，必须逐增量交付各自的 Red 和 Green；不得用一次性全量实现的两条记录替代其他增量。 每条 run 必须记录实际 environment（runtime、version、platform、arch，可选 image）及 termination（status、signal、error、timed_out、cancelled）。正常退出也明确 signal=null、error=null、timed_out=false、cancelled=false；未知或中断保持原事实，不得作为 Green。环境仅采集重现执行必需的运行时元数据，不收集环境变量或凭据。",
    "content_schema": {
      "type": "object",
      "required": [
        "runs"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "sequence",
              "phase",
              "command",
              "cwd",
              "started_at",
              "finished_at",
              "exit_code",
              "stdout",
              "stderr",
              "files",
              "environment",
              "termination"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "phase": {
                "enum": [
                  "red",
                  "green",
                  "regression"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "started_at": {
                "type": "string",
                "minLength": 1
              },
              "finished_at": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "sha256",
                    "content"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "environment": {
                "type": "object",
                "required": [
                  "runtime",
                  "version",
                  "platform",
                  "arch"
                ],
                "properties": {
                  "runtime": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "platform": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "image": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "termination": {
                "type": "object",
                "required": [
                  "status",
                  "signal",
                  "error",
                  "timed_out",
                  "cancelled"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "exited",
                      "signalled",
                      "timed_out",
                      "cancelled",
                      "unknown"
                    ]
                  },
                  "signal": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timed_out": {
                    "type": "boolean"
                  },
                  "cancelled": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "spec_refs": []
  }
}
