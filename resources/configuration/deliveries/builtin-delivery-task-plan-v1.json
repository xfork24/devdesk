{
  "kind": "delivery_type",
  "identity": "builtin-delivery-task-plan",
  "revision": 1,
  "name": "任务集合",
  "scope": {
    "kind": "global"
  },
  "data": {
    "body": "任务集合，按绑定的输入与输出声明提交。",
    "format": "json",
    "content_schema": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "title",
              "instructions",
              "dependencies"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "instructions": {
                "type": "string"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "spec_refs": []
  }
}
