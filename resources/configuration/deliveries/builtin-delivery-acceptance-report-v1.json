{
  "type": "delivery_type",
  "identity": "builtin-delivery-acceptance-report",
  "revision": 1,
  "name": "Acceptance Report",
  "scope": "global",
  "spec_refs": [
    "builtin-spec-delivery-acceptance-report:1"
  ],
  "data": {
    "format": "json",
    "content_schema": {
      "type": "object",
      "required": [
        "revision",
        "previous",
        "operation_id"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "previous": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "producer": {
      "kind": "platform",
      "tools": [
        "git.advance"
      ]
    }
  }
}
