{
  "type": "delivery_type",
  "identity": "精简版-delivery-test-recipe",
  "revision": 1,
  "name": "精简版独立测试配方",
  "scope": "global",
  "spec_refs": [
    "精简版-spec-tests:1"
  ],
  "data": {
    "format": "json",
    "producer": {
      "kind": "agent"
    },
    "content_schema": {
      "type": "object",
      "required": [
        "scope",
        "cases",
        "recipe",
        "interfaces"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "acceptance",
              "expected",
              "files"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "recipe": {
          "type": "object",
          "required": [
            "runner",
            "files",
            "timeout_seconds"
          ],
          "properties": {
            "runner": {
              "enum": [
                "node_test",
                "python_unittest"
              ]
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7200
            }
          },
          "additionalProperties": false
        },
        "interfaces": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "runner",
              "exports"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "runner": {
                "enum": [
                  "node_test",
                  "python_unittest"
                ]
              },
              "exports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
