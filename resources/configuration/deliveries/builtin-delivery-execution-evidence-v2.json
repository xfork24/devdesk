{
  "kind": "delivery_type",
  "identity": "builtin-delivery-execution-evidence",
  "revision": 2,
  "name": "Execution Report",
  "scope": {
    "kind": "global"
  },
  "data": {
    "format": "json",
    "spec_refs": [
      "builtin-spec-delivery-execution-evidence:1"
    ],
    "content_schema": {
      "type": "object",
      "required": [
        "runs"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "sequence",
              "phase",
              "command",
              "cwd",
              "started_at",
              "finished_at",
              "exit_code",
              "stdout",
              "stderr",
              "files",
              "environment",
              "termination"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "phase": {
                "enum": [
                  "red",
                  "green",
                  "regression"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "started_at": {
                "type": "string",
                "minLength": 1
              },
              "finished_at": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "sha256",
                    "content"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "environment": {
                "type": "object",
                "required": [
                  "runtime",
                  "version",
                  "platform",
                  "arch"
                ],
                "properties": {
                  "runtime": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "platform": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "image": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "termination": {
                "type": "object",
                "required": [
                  "status",
                  "signal",
                  "error",
                  "timed_out",
                  "cancelled"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "exited",
                      "signalled",
                      "timed_out",
                      "cancelled",
                      "unknown"
                    ]
                  },
                  "signal": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timed_out": {
                    "type": "boolean"
                  },
                  "cancelled": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "kind": "agent"
    }
  }
}
