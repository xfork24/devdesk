{
  "type": "delivery_type",
  "identity": "builtin-delivery-workspace-snapshot",
  "revision": 1,
  "name": "Workspace Snapshot",
  "scope": "global",
  "spec_refs": [
    "builtin-spec-delivery-workspace-snapshot:1"
  ],
  "data": {
    "format": "json",
    "content_schema": {
      "type": "object",
      "required": [
        "workspace_id",
        "owner_id",
        "revision"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      },
      "additionalProperties": true
    },
    "producer": {
      "kind": "platform",
      "tools": [
        "workspace.current",
        "workspace.snapshot"
      ]
    }
  }
}
